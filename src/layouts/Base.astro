---
import '@fontsource-variable/inter';
import '../styles/global.css';
import { Image } from 'astro:assets';
import Brand from '../components/Brand.astro';
import elite from '../assets/brand/homeadvisor-elite.png';
import screened from '../assets/brand/homeadvisor-screened.png';
import { business as b, hours, nav, services, towns, townHref } from '../data/site';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  crumbs?: { name: string; href: string }[];
  faqs?: { q: string; a: string }[];
  // Town pages narrow areaServed to their own town.
  areaServed?: string[];
}
const { title, description, noindex = false, crumbs = [], faqs = [], areaServed } = Astro.props;
const path = Astro.url.pathname;
const canonical = new URL(path, b.url).href;
const pageTitle = path === '/' ? title : `${title} | ${b.shortName} Mobile Locksmith`;
const ogImage = `${b.url}/og.jpg`;
const businessId = `${b.url}/#business`;

const graph: Record<string, unknown>[] = [
  {
    '@type': 'Locksmith',
    '@id': businessId,
    name: b.name,
    legalName: b.legalName,
    alternateName: b.nickname,
    description: 'Mobile locksmith serving North Alabama: car door unlocking, automotive key cutting and programming, key fobs and push-to-start keys, residential and commercial rekeys, and doorknob and deadbolt installs.',
    url: `${b.url}/`,
    telephone: b.phoneSchema,
    email: b.email,
    image: ogImage,
    logo: `${b.url}/logo.png`,
    priceRange: '$65 – $350',
    address: { '@type': 'PostalAddress', addressRegion: 'AL', addressCountry: 'US' },
    openingHoursSpecification: hours.map((h) => ({ '@type': 'OpeningHoursSpecification', ...h.schema })),
    areaServed: (areaServed ?? towns.map((t) => `${t.name}, AL`)).map((name) => ({ '@type': 'City', name })),
    sameAs: [b.facebook, b.instagram],
  },
  { '@type': 'WebSite', '@id': `${b.url}/#website`, url: `${b.url}/`, name: b.name, publisher: { '@id': businessId } },
  { '@type': 'WebPage', '@id': `${canonical}#webpage`, url: canonical, name: pageTitle, description, isPartOf: { '@id': `${b.url}/#website` }, about: { '@id': businessId } },
];
if (crumbs.length) {
  const trail = [{ name: 'Home', href: '/' }, ...crumbs];
  graph.push({ '@type': 'BreadcrumbList', itemListElement: trail.map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: c.name, item: new URL(c.href, b.url).href })) });
}
if (faqs.length) {
  graph.push({ '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) });
}
const schema = { '@context': 'https://schema.org', '@graph': graph };
const current = (href: string) => {
  if (href.includes('#')) return undefined;
  return (href === '/' ? path === '/' : path.startsWith(href)) ? 'page' : undefined;
};
---
<!doctype html>
<html lang="en-US">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{pageTitle}</title>
  <meta name="description" content={description} />
  <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large'} />
  {!noindex && <link rel="canonical" href={canonical} />}
  <meta name="geo.region" content="US-AL" />
  <meta name="geo.placename" content="North Alabama" />
  <link rel="icon" href="/favicon.ico" sizes="any" />
  <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <meta name="theme-color" content="#0d1440" />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content={b.name} />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />
  <script async src={`https://www.googletagmanager.com/gtag/js?id=${b.gaId}`}></script>
  <script is:inline define:vars={{ id: b.gaId }}>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}gtag('js',new Date());gtag('config',id);</script>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
</head>
<body>
  <a class="skip" href="#main">Skip to main content</a>
  <div class="topbar">
    <div class="wrap topbar__in">
      <ul>
        <li>Serving {b.region} &amp; surrounding areas</li>
        <li><a href={`mailto:${b.email}`}>{b.email}</a></li>
      </ul>
      <div class="topbar__right">
        <ul>
          <li><a href={b.smsHref}>Text us</a></li>
          <li><a href={b.facebook} rel="noopener">Facebook</a></li>
          <li><a href={b.instagram} rel="noopener">Instagram</a></li>
        </ul>
      </div>
    </div>
  </div>
  <header class="header">
    <div class="wrap header__in">
      <Brand eager />
      <nav class="nav" aria-label="Main">
        {nav.map((n) => <a href={n.href} aria-current={current(n.href)}>{n.label}</a>)}
      </nav>
      <div class="header__cta">
        <a class="btn btn--yellow btn--stack" href={b.phoneHref}><span class="btn__small">I need help now</span>{b.phoneDisplay}</a>
      </div>
      <details class="menu">
        <summary>Menu</summary>
        <nav aria-label="Mobile">
          {nav.map((n) => <a href={n.href} aria-current={current(n.href)}>{n.label}</a>)}
          <a class="btn btn--yellow" href={b.phoneHref}>Call {b.phoneDisplay}</a>
        </nav>
      </details>
    </div>
  </header>

  <main id="main"><slot /></main>

  <footer class="footer">
    <div class="wrap footer__grid">
      <div>
        <Brand />
        <p>{b.region}’s full service provider of premium locksmith services for your home, auto, or business needs.</p>
        <div class="social">
          <a href={b.facebook} rel="noopener" aria-label="Facebook"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 8h3V4h-3c-2.8 0-4.5 1.8-4.5 4.6V11H7v4h2.5v9h4v-9h3l.5-4h-3.5V8.8c0-.5.3-.8.5-.8Z"/></svg></a>
          <a href={b.instagram} rel="noopener" aria-label="Instagram"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 7.3A4.7 4.7 0 1 0 12 16.7 4.7 4.7 0 0 0 12 7.3Zm0 7.7a3 3 0 1 1 0-6 3 3 0 0 1 0 6Zm4.9-8.9a1.1 1.1 0 1 0 0 2.2 1.1 1.1 0 0 0 0-2.2ZM21.9 7c-.1-1.6-.4-3-1.6-4.2S17.6 1.2 16 1.1C14.4 1 9.6 1 8 1.1 6.4 1.2 5 1.5 3.8 2.7S2.2 5.4 2.1 7C2 8.6 2 13.4 2.1 15c.1 1.6.4 3 1.6 4.2s2.6 1.5 4.2 1.6c1.6.1 6.4.1 8 0 1.6-.1 3-.4 4.2-1.6s1.5-2.6 1.6-4.2c.1-1.6.1-6.4 0-8Zm-2.1 9.7a3.3 3.3 0 0 1-1.8 1.8c-1.3.5-4.3.4-5.7.4s-4.4.1-5.7-.4a3.3 3.3 0 0 1-1.8-1.8c-.5-1.3-.4-4.3-.4-5.7s-.1-4.4.4-5.7A3.3 3.3 0 0 1 6.6 3.5c1.3-.5 4.3-.4 5.7-.4s4.4-.1 5.7.4a3.3 3.3 0 0 1 1.8 1.8c.5 1.3.4 4.3.4 5.7s.1 4.4-.4 5.7Z"/></svg></a>
        </div>
        <div class="trust">
          <Image src={elite} alt="HomeAdvisor Elite Service" height={128} />
          <Image src={screened} alt="HomeAdvisor Screened & Approved" height={128} />
        </div>
      </div>
      <div>
        <p class="footer__title">Quick Links</p>
        <ul>
          {nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
          <li><a href="/privacy-policy/">Privacy Policy</a></li>
        </ul>
      </div>
      <div>
        <p class="footer__title">Services</p>
        <ul>{services.map((s) => <li><a href={`/locksmith-services/${s.anchor || '#services'}`}>{s.name}</a></li>)}</ul>
      </div>
      <div>
        <p class="footer__title">Contact Us Today</p>
        <p><a href={b.phoneHref}><strong>{b.phoneDisplay}</strong></a><br />Call or text</p>
        <p><a href={`mailto:${b.email}`}>{b.email}</a></p>
        <p>{hours.map((h) => <>{h.days}: {h.time}<br /></>)}Emergencies: 24/7</p>
        <p class="footer__title" style="margin-top:1.25rem">Service Areas</p>
        <p>{towns.map((t, i) => <>{i ? ', ' : ''}<a href={townHref(t.slug)}>{t.name}</a></>)}</p>
      </div>
    </div>
    <p class="wrap footer__legal">© {new Date().getFullYear()} {b.legalName}. All rights reserved. · <a href="/sitemap-index.xml">Sitemap</a></p>
    <p class="wrap footer__credit">Website by <a href="https://datasoar.io" rel="noopener">DataSoar</a></p>
  </footer>

  <div class="callbar">
    <a class="btn btn--yellow" href={b.phoneHref}>Call now</a>
    <a class="btn btn--ghost" href={b.smsHref}>Text us</a>
  </div>
  <script is:inline>
    // Mobile menu: lock the page behind it and size the panel to the space under the header.
    (function () {
      var menu = document.querySelector('.menu');
      var header = document.querySelector('.header');
      if (!menu || !header) return;
      var root = document.documentElement;
      var place = function () { root.style.setProperty('--menu-top', Math.max(0, header.getBoundingClientRect().bottom) + 'px'); };
      place();
      menu.addEventListener('toggle', function () {
        if (menu.open) place();
        root.classList.toggle('menu-open', menu.open);
      });
      menu.addEventListener('click', function (e) { if (e.target.closest('a')) menu.open = false; });
      document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && menu.open) { menu.open = false; menu.querySelector('summary').focus({ preventScroll: true }); } });
      window.addEventListener('resize', function () { if (menu.open) { if (innerWidth > 1080) menu.open = false; else place(); } });
    })();
    // Pop-in on scroll and key-pin reels. Both stay still for reduced motion or without IntersectionObserver.
    (function () {
      if (!('IntersectionObserver' in window) || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      var root = document.documentElement;
      root.classList.add('reveal-armed');
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (e) { if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); } });
      }, { rootMargin: '0px 0px -8% 0px' });
      document.querySelectorAll('[data-reveal]').forEach(function (el) { io.observe(el); });

      var stats = document.querySelector('[data-slots]');
      if (!stats) return;
      stats.classList.add('slots-armed');
      var spin = function (li) {
        li.classList.remove('is-spinning', 'is-landed');
        void li.offsetWidth;
        li.classList.add('is-spinning');
        var reels = li.querySelectorAll('.reel__strip');
        var last = reels[reels.length - 1];
        if (!last) return;
        last.addEventListener('animationend', function () { li.classList.add('is-landed'); }, { once: true });
      };
      var so = new IntersectionObserver(function (entries) {
        if (!entries[0].isIntersecting) return;
        so.disconnect();
        stats.querySelectorAll('li').forEach(spin);
      }, { threshold: .5 });
      so.observe(stats);
      stats.querySelectorAll('li').forEach(function (li) { li.addEventListener('click', function () { spin(li); }); });
    })();
  </script>
</body>
</html>
